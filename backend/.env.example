# Firebase Web API key used only to verify Firebase ID tokens via Identity Toolkit.
FIREBASE_API_KEY=

# Comma-separated browser origins allowed to call the HTTP API and open WebSockets.
# Production example:
# CORS_ORIGIN=https://quizzup-ten.vercel.app
CORS_ORIGIN=

# Set true only when the backend is behind a trusted reverse proxy that sets
# X-Forwarded-For (e.g. Railway). Leave false for direct/local connections.
TRUST_PROXY=false

# Optional. 0 disables the per-IP WebSocket connection cap. Default: 100.
MAX_WS_CONNECTIONS_PER_IP=100

# Railway usually injects PORT automatically.
PORT=3001
