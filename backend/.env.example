# Firebase Web API key used only for optional Google-linked accounts.
# Guest gameplay does not depend on Firebase.
FIREBASE_API_KEY=

# Required in production. Random secret used to sign QuizzUp guest identities.
# Use at least 32 random characters and never expose it to the frontend.
GUEST_AUTH_SECRET=
# Optional guest-token lifetime in days. Default: 90, allowed: 1-365.
GUEST_AUTH_TTL_DAYS=90

# Comma-separated browser origins allowed to call the HTTP API and open WebSockets.
# Production example:
# CORS_ORIGIN=https://quizzup-ten.vercel.app
CORS_ORIGIN=

# Set true only when the backend is behind a trusted reverse proxy that sets
# X-Forwarded-For (e.g. Railway). Leave false for direct/local connections.
TRUST_PROXY=false
# Number of trusted reverse-proxy hops. Railway-only is normally 1; if another
# trusted CDN/proxy sits in front of Railway, set this to the total trusted hops.
TRUST_PROXY_HOPS=1

# Optional. 0 disables the per-IP WebSocket connection cap. Default: 100.
MAX_WS_CONNECTIONS_PER_IP=100

# Railway usually injects PORT automatically.
PORT=3001

# Optional durable directory for stats/social/feed/moderation JSON stores.
# On Railway, point this at the mount path of a persistent Volume.
# Example: DATA_DIR=/data
# Leave empty to keep the current single-instance backend-directory behavior.
DATA_DIR=

# Optional. Enables GET /admin/category-stats (which quiz themes are played).
# Use a long random string (32+ chars). Leave empty to keep the endpoint disabled.
ADMIN_STATS_TOKEN=
