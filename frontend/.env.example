REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
# Full WebSocket URL of the deployed backend (e.g. wss://your-app.up.railway.app/ws).
# Leave unset for local dev — the app then assumes frontend:3000 + backend:3001 on localhost.
REACT_APP_WS_URL=

# Optional HTTP backend origin. Production has a built-in Railway fallback.
# Example: https://your-app.up.railway.app
REACT_APP_API_URL=

# Optional public site URL for SEO tags, sitemap and robots.txt.
# Leave empty on Vercel: the production domain is detected automatically
# (the .vercel.app address today, your custom domain once attached).
REACT_APP_SITE_URL=
